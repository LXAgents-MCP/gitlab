{
  "name": "@lxagents-mcp/gitlab",
  "version": "0.2.0",
  "description": "MCP server that gives an LLM access to GitLab — projects, branches, files, commits, tags, releases, issues, merge requests and CI/CD pipelines — through the GitLab REST API. Stdio, or HTTP with a bearer token.",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "lxagents-gitlab": "src/index.js"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/http.js",
    "test": "node --test",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "LXAgents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXAgents-MCP/gitlab.git"
  },
  "homepage": "https://github.com/LXAgents-MCP/gitlab#readme",
  "bugs": {
    "url": "https://github.com/LXAgents-MCP/gitlab/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gitlab",
    "lxagents"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  }
}
