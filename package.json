{
  "name": "@lxagents-mcp/gitlab",
  "version": "0.6.1",
  "description": "MCP server that gives an LLM access to GitLab — projects, branches, files, commits, tags, releases, issues, merge requests and CI/CD pipelines — through the GitLab REST API. Stdio, or HTTP behind an access token.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lxagents-gitlab": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "start:http": "node dist/routes/http.js",
    "test": "node --import tsx --test test/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "LXAgents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXAgents-MCP/gitlab.git"
  },
  "homepage": "https://github.com/LXAgents-MCP/gitlab#readme",
  "bugs": {
    "url": "https://github.com/LXAgents-MCP/gitlab/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gitlab",
    "lxagents"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
